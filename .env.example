
# Moirai Environment Variables Example
# Copy this file to .env and fill in your values
# Do not commit .env to version control

# API Configuration
API_USERNAME=admin
API_PASSWORD=password
HTTP_PORT=8088

# Database Configuration
COUCHDB_USER=admin
COUCHDB_PASSWORD=password
COUCHDB_SECRET=secret

# LLM Configuration
# OpenAI API Key (optional if provided via UI)
OPENAI_API_KEY=sk-your-openai-key-here

# Gemini API Key (optional if provided via UI)
GEMINI_API_KEY=your-gemini-key-here

# Ollama Configuration
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Model Configuration
MODEL_NAME=llama3.1:latest

# MCP Server
MCP_SERVER_URL=http://mcp-server:8090/sse

# Other Settings
ALLOW_PUBLIC_READ=true
ARTICLE_EXPIRATION_DAYS=30
ITERATION_INTERVAL=300
